{
  "kind": "version",
  "cases": [
    {
      "name": "v 접두",
      "expected": "v1.2.0",
      "actual": "1.2.0",
      "expect": "equal"
    },
    {
      "name": "빠진 자리",
      "expected": "1.2",
      "actual": "1.2.0",
      "expect": "equal"
    },
    {
      "name": "v + 빠진 자리",
      "expected": "v1.2",
      "actual": "1.2.0",
      "expect": "equal"
    },
    {
      "name": "빌드 메타 무시",
      "expected": "1.2.3+build.5",
      "actual": "1.2.3",
      "expect": "equal"
    },
    {
      "name": "range ^",
      "expected": "1.4.2",
      "actual": "1.4.2",
      "expect": "equal",
      "options": {
        "range": "^1.2.0"
      }
    },
    {
      "name": "range >=",
      "expected": "2.0.0",
      "actual": "2.0.0",
      "expect": "equal",
      "options": {
        "range": ">=1.0.0"
      }
    },
    {
      "name": "마이너 다름",
      "expected": "1.2.0",
      "actual": "1.3.0",
      "expect": "different"
    },
    {
      "name": "프리릴리스 다름",
      "expected": "1.2.0",
      "actual": "1.2.0-beta.1",
      "expect": "different"
    },
    {
      "name": "메이저 다름",
      "expected": "2.0.0",
      "actual": "1.0.0",
      "expect": "different"
    },
    {
      "name": "range 밖",
      "expected": "2.0.0",
      "actual": "2.0.0",
      "expect": "different",
      "options": {
        "range": "^1.2.0"
      }
    }
  ]
}
