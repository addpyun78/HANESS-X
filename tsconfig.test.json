{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@harness-x/agent-builder": ["./packages/plugins-core/agent-builder/src/index.ts"],
      "@harness-x/checklist-ledger": ["./packages/plugins-core/checklist-ledger/src/index.ts"],
      "@harness-x/engine-openai-compat": ["./packages/engines/openai-compat/src/index.ts"],
      "@harness-x/engine-scanner": ["./packages/plugins-core/engine-scanner/src/index.ts"],
      "@harness-x/kernel": ["./packages/kernel/src/index.ts"],
      "@harness-x/protocol": ["./packages/protocol/src/index.ts"],
      "@harness-x/sdk": ["./packages/sdk/src/index.ts"],
      "@harness-x/verifier-ladder": ["./packages/plugins-core/verifiers/ladder/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "tests/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
