{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@harness-x/agent-builder": ["./packages/plugins-core/agent-builder/src/index.ts"],
      "@harness-x/approvals": ["./packages/plugins-core/approvals/src/index.ts"],
      "@harness-x/checklist-ledger": ["./packages/plugins-core/checklist-ledger/src/index.ts"],
      "@harness-x/engine-acp-generic": ["./packages/engines/acp-generic/src/index.ts"],
      "@harness-x/engine-antigravity": ["./packages/engines/antigravity/src/index.ts"],
      "@harness-x/engine-claude-code": ["./packages/engines/claude-code/src/index.ts"],
      "@harness-x/engine-codex": ["./packages/engines/codex/src/index.ts"],
      "@harness-x/engine-openai-compat": ["./packages/engines/openai-compat/src/index.ts"],
      "@harness-x/engine-scanner": ["./packages/plugins-core/engine-scanner/src/index.ts"],
      "@harness-x/forge": ["./packages/plugins-core/forge/src/index.ts"],
      "@harness-x/installer": ["./packages/plugins-core/installer/src/index.ts"],
      "@harness-x/judge": ["./packages/plugins-core/verifiers/judge/src/index.ts"],
      "@harness-x/kernel": ["./packages/kernel/src/index.ts"],
