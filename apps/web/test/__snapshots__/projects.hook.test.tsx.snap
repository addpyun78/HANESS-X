exports[`0B.33 모바일(768px 미만) > 사이드바는 시트로 열리고 구조는 같다 (뷰포트 스냅샷) 1`] = `"<nav class="hx-sidebar hx-psidebar" aria-label="사이드바"><div class="hx-newsession" role="group" aria-label="새 세션"><button data-action="projects.new-session" type="button" class="hx-newsession__main" title="지금 프로젝트에서 새 세션 (Ctrl+N)">+ 새 세션</button><button data-action="projects.pick-new" type="button" class="hx-newsession__more" aria-label="프로젝트 골라서 새 세션" title="프로젝트 골라서 새 세션 (Ctrl+Shift+N)" aria-expanded="false" aria-haspopup="menu">▾</button></div><input class="hx-psidebar__search" aria-label="세션·프로젝트 찾기" placeholder="🔍 세션·프로젝트 찾기" type="search" value=""><div class="hx-psidebar__head"><h2>프로젝트</h2><button data-action="projects.open-folder" type="button">폴더 열기</button></div><ul class="hx-psidebar__groups" aria-label="프로젝트 목록"><li class="hx-pgroup" data-group="a" draggable="true"><div class="hx-pgroup__row"><button data-action="projects.group-toggle" type="button" class="hx-pgroup__toggle" aria-expanded="true" aria-label="alpha 접기">▾</button><button data-action="projects.select" type="button" class="hx-pgroup__name"><span aria-hidden="true">📁 </span>alpha</button><button data-action="projects.new-in-project" type="button" class="hx-pgroup__new" aria-label="alpha에서 새 세션">+</button><button data-action="projects.menu" type="button" class="hx-pgroup__more" aria-label="alpha 메뉴" aria-haspopup="menu" aria-expanded="false">…</button></div><ul class="hx-pgroup__sessions" aria-label="alpha 세션"></ul></li></ul><div class="hx-psidebar__controls" role="group" aria-label="묶기와 필터"><label>묶기<select aria-label="묶기"><option value="project">프로젝트</option><option value="status">상태</option><option value="date">날짜</option><option value="none">묶지 않음</option></select></label><label>정렬<select aria-label="정렬"><option value="recent">최근 활동</option><option value="name">이름순</option><option value="manual">내가 정한 순서</option></select></label><label>필터<select aria-label="상태 필터"><option value="all">전체</option><option value="running">진행 중</option><option value="needs-approval">확인 필요</option><option value="paused">멈춤</option><option value="done">완료</option><option value="idle">대기</option><option value="error">문제 있음</option></select></label><select aria-label="엔진 필터"><option value="all">모든 AI</option></select><select aria-label="에이전트 필터"><option value="all">모든 에이전트</option></select></div><div class="hx-sidebar__nav" role="menu" aria-label="하단 메뉴"><button data-action="nav.agent-builder" type="button" role="menuitem" class="hx-nav-item"><span aria-hidden="true">✦</span>에이전트 만들기</button><button data-action="nav.plugins" type="button" role="menuitem" class="hx-nav-item" disabled="" title="준비 중이에요"><span aria-hidden="true">⧉</span>플러그인</button><button data-action="nav.skills" type="button" role="menuitem" class="hx-nav-item" disabled="" title="준비 중이에요"><span aria-hidden="true">◇</span>스킬</button><button data-action="nav.install" type="button" role="menuitem" class="hx-nav-item"><span aria-hidden="true">⬇</span>설치 관리</button><button data-action="nav.engines" type="button" role="menuitem" class="hx-nav-item"><span aria-hidden="true">⚙</span>엔진</button><button data-action="nav.settings" type="button" role="menuitem" class="hx-nav-item" disabled="" title="준비 중이에요"><span aria-hidden="true">☰</span>설정</button></div></nav>"`;
