exports[`1E.7 모바일: 끌어 놓기 대신 파일 선택 버튼 (뷰포트) > 375px 터치 화면이면 "파일 선택" 버튼, 넓은 화면이면 없음 1`] = `"<button data-action="composer.plus" type="button" class="hx-plus" aria-label="추가" data-slot="plus" aria-haspopup="menu" aria-expanded="false">+</button><div class="hx-chip-wrap hx-chip--permission"><button data-action="composer.chip" type="button" class="hx-chip" aria-label="권한: 워크스페이스 쓰기" aria-haspopup="menu" aria-expanded="false"><span aria-hidden="true">◎</span><span>워크스페이스 쓰기</span><span class="hx-chip__caret" aria-hidden="true">▾</span></button></div><div class="hx-chip-wrap hx-chip--mode"><button data-action="composer.chip" type="button" class="hx-chip" aria-label="모드: 일반" aria-haspopup="menu" aria-expanded="false"><span>일반</span><span class="hx-chip__caret" aria-hidden="true">▾</span></button></div><button data-action="composer.attach-pick" type="button" class="hx-attach-pick" aria-label="파일 선택">📎 파일</button><span class="hx-composer__spacer"></span><button data-action="composer.send" type="button" class="hx-send" aria-label="전송" disabled="" title="보낼 내용을 먼저 적어 주세요">↑</button>"`;
