exports[`50.2 템플릿 변수 치환기 > 스냅샷: hook 템플릿 렌더링 1`] = `
{
  "harness-plugin.json": "{
  "id": "commit-guard",
  "version": "0.1.0",
  "apiVersion": 1,
  "displayName": "커밋 가드",
  "description": "커밋 전에 \\"비밀\\" 값이 없는지 검사한다",
  "main": "dist/index.js",
  "provides": {
    "hook": ["commit-guard"]
  },
  "permissions": {"fs":["workspace:read"],"net":["api.example.com"],"shell":true}
}
",
  "package.json": "{
  "name": "commit-guard",
  "version": "0.1.0",
  "private": true,
  "description": "커밋 전에 \\"비밀\\" 값이 없는지 검사한다",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
",
  "src/index.ts": "/**
 * 커밋 가드 — 훅 플러그인
 * 차단형(onBlocking)은 allow/deny/block을 돌려주고, 알림형(onNotify)은 결과를 돌려주지 않는다.
 */

export type HookName =
  | 'session.start'
  | 'prompt.submit'
  | 'tool.before'
  | 'tool.after'
  | 'turn.end'
  | 'stop.before'
  | 'context.compact'
  | 'item.verify';

export interface HookContext {
  sessionId?: string;
  [key: string]: unknown;
}

export interface HookResult {
  decision: 'allow' | 'deny' | 'block';
  reason?: string;
}

export interface PluginContext {
  manifest: { id: string; version: string };
  log(message: string): void;
  hooks: {
    onBlocking(name: HookName, handler: (ctx: HookContext) => HookResult | void): () => void;
    onNotify(name: HookName, handler: (ctx: HookContext) => void): () => void;
  };
}

export const HOOK_ID = 'commit-guard';

export function activate(ctx: PluginContext): void {
  ctx.hooks.onNotify('session.start', (c) => ctx.log(\`\${HOOK_ID}: session \${c.sessionId ?? '?'} started\`));
  ctx.hooks.onBlocking('tool.before', () => ({ decision: 'allow' }));
}

export function deactivate(): void {}
",
  "tsconfig.json": "{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
",
}
`;

